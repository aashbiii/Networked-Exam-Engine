<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Primary Connection String: (localdb)\MSSQLLocalDB (Installed and active on your PC) -->
    <add name="ExamEngineDB" 
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ExamEngineDB;Integrated Security=True;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
         
    <!-- Alternative for SQL Server Authentication (sa):
    <add name="ExamEngineDB_SqlAuth" 
         connectionString="Data Source=.;Initial Catalog=ExamEngineDB;User Id=sa;Password=your_password;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
